# Copy to .env.local for local development, or configure these names in the deployment environment.
# Never commit real values. VITE_ variables are included in the browser bundle.

# Public client configuration required by the storefront.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backward-compatible aliases accepted by vite.config.ts if VITE_* names are unset.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional email confirmation callback; empty uses the current origin + /auth/callback.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# Server/runtime only. Keep values in deployment secrets; do not prefix with VITE_ or expose to browsers.
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
